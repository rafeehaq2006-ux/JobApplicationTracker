<!DOCTYPE html>
<html>
    <%- include("./partials/head.ejs") %>
    <body>
        <%- include("./partials/nav.ejs") %>
        <div id="JobDetailsContainer">
            <div>
                <div id="JobTitle"><%= job.job_title %></div>
                <div id="companyname"><%= job.company_name %></div>
            </div>
            <div id="JobDescription">Description: <%= job.description %></div>
            <div id="Requirements">Requirements: <%= job.requirements %></div>
            <div id="Salary">Salary: <%= salary %></div>
            <div id="location">Location: <%= job.location %></div>
            <div id="website">
                <a href="<%= job.website.startsWith('http') ? job.website : 'https://' + job.website %>" target="_blank" rel="noopener noreferrer">
                    <%= job.website %>
                </a>
            </div>
        </div>
    </body>
</html>