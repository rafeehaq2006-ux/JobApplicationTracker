<!DOCTYPE html>
<html>
    <%- include("./partials/head.ejs") %>
    <body>
        <%- include("./partials/nav.ejs") %>
        <div id="JobDetailsContainer">
            <div class="job-header">
                <div class="job-title-row">
                    <div id="JobTitle"><%= job.job_title %></div>
                    <div id="companyname"><%= job.company_name %></div>
                </div>
                <div class="job-icon-actions">
                    <button type="button" id="editJobButton" aria-label="Edit job details">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 20h9"></path>
                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                        </svg>
                    </button>
                    <button type="button" id="deleteJobButton" aria-label="Delete job">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 6h18"></path>
                            <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                            <path d="M10 11v6"></path>
                            <path d="M14 11v6"></path>
                        </svg>
                    </button>
                </div>
            </div>
            <div id="JobDescription">Description: <%= job.description %></div>
            <div id="Requirements">Requirements: <%= job.requirements %></div>
            <div id="Salary">Salary: <%= salary %></div>
            <div id="location">Location: <%= job.location %></div>
            <div id="website">
                <a href="<%= job.website.startsWith('http') ? job.website : 'https://' + job.website %>" target="_blank" rel="noopener noreferrer">
                    <%= job.website %>
                </a>
            </div>
        </div>
    </body>
</html>